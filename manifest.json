{
  "manifest_version": 3,
  "name": "Bili Lottery Clicker",
  "version": "4.1.0",
  "minimum_chrome_version": "120",
  "description": "自动打开 B 站抽奖动态页面，并显示悬浮控制面板",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*"
  ],
  "action": {
    "default_title": "Bili Lottery Clicker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon.png"
  }
}
